{
  "forgejo_url": "https://forge.example.internal",
  "owner": "team",
  "repo": "project",
  "token_env": "IRIS_FORGEJO_TOKEN",
  "git_url": "https://forge.example.internal/team/project.git",
  "base_branch": "main",
  "labels": {"ready": "ready", "in_progress": "in-progress", "review": "review", "blocked": "blocked"},
  "builder": ["qwen", "-p", "{prompt}", "--yolo", "--safe-mode", "--max-wall-time", "25m", "--max-session-turns", "80", "--output-format", "stream-json"],
  "builder_env": ["OPENAI_BASE_URL", "OPENAI_MODEL", "OPENAI_API_KEY"],
  "check_command": "./scripts/verify.sh",
  "sandbox": "docker",
  "image": "registry.local/project-builder@sha256:<digest>",
  "docker_network": "builder-egress",
  "wall_time_seconds": 1800,
  "check_timeout_seconds": 900,
  "repair_rounds": 2,
  "max_changed_files": 20,
  "max_changed_lines": 400,
  "protected_paths": [".woodpecker.yml", ".woodpecker/*", "AGENTS.md", "scripts/verify.sh", "plan/*"],
  "log_dir": "/var/lib/iris/project"
}
